# Cấu hình CSDL (Mặc định dùng SQLite cho môi trường phát triển)
# Bạn có thể đổi sang PostgreSQL hoặc MySQL bằng cách thay đổi DATABASE_URL
DATABASE_URL=postgresql://postgres:1@localhost:5432/do_an_db

# Ví dụ cấu hình cho PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/db_name

# Ví dụ cấu hình cho MySQL:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/db_name

# Cấu hình ứng dụng
APP_ENV=development
SECRET_KEY=supersecretkeyforcompliancechecking
# JWT: thời gian hết hạn token (phút) — mặc định 480 phút = 8 giờ
ACCESS_TOKEN_EXPIRE_MINUTES=480

# BuzzASR GPU Server (Tailscale)
ASR_BASE_URL=http://localhost:8000
ASR_API_KEY=8N0nLXpRh/zcciG5T9PGZw+9hqGD77am8ul73Xy9DdU=
